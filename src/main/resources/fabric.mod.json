{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": ["${mod_author}"],
	"contact": {
		"homepage": "https://www.pnku.de",
		"email": "contact@pnku.de",
		"sources": "https://github.com/pnk2u/More-Composter-Variants",
		"issues": "https://github.com/pnk2u/More-Composter-Variants/issues"
	},
	"license": "${mod_license}",
	"icon": "logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "de.pnku.mcmv.MoreComposterVariants"
		]
	},
	"mixins": [
		"lolmcmv.mixins.json"
	],
	"accessWidener": "lolmcmv.accesswidener" ,
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">${minecraft_version_0} <${minecraft_version_1}",
		"java": ">=${java_version}",
		"fabric-api": ">=0.92.0"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "discord.lieonlion.dev"
			}
		},
		"mc-publish": {
			"modrinth": "vDjDgFj7",
			"curseforge": "1058421",
			"dependencies": [
				"fabric-api(required)#(ignore)"
			]
		}
	}
}